diff --git a/inform/extra_test.go b/inform/extra_test.go
new file mode 100644
index 0000000..58d5fc9
--- /dev/null
+++ b/inform/extra_test.go
@@ -0,0 +1,37 @@
+package inform
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestBuildPayloadExtraMergesOverBuiltins(t *testing.T) {
+	s := NewSession(Descriptor{
+		MAC: "00:27:22:e0:00:01", Model: "UXGENT", Type: "uxg",
+		UDAPIVersion: "2.0.0", UDAPICaps: 5,
+		Extra: map[string]any{
+			"etherlight_caps": 7,
+			"switch_caps":     map[string]any{"feature_caps": 4194304},
+			"udapi_version":   map[string]any{"versionDetail": map[string]any{"firewall/filter": 4}},
+		},
+	}, "http://x/inform", time.Unix(0, 0))
+
+	var got map[string]any
+	if err := json.Unmarshal(s.BuildPayload(time.Unix(0, 0)), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["etherlight_caps"] != float64(7) {
+		t.Errorf("etherlight_caps = %v", got["etherlight_caps"])
+	}
+	if got["switch_caps"].(map[string]any)["feature_caps"] != float64(4194304) {
+		t.Errorf("switch_caps = %v", got["switch_caps"])
+	}
+	u := got["udapi_version"].(map[string]any)
+	if u["version"] != "2.0.0" || u["versionDetail"].(map[string]any)["firewall/filter"] != float64(4) {
+		t.Errorf("udapi_version must keep the built-in version and gain versionDetail, got %v", u)
+	}
+	if got["udapi_caps"] != float64(5) {
+		t.Errorf("built-in udapi_caps was lost: %v", got["udapi_caps"])
+	}
+}
