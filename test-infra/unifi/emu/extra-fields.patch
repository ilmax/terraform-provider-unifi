+
+// mergeExtra copies extra into dst: nested maps merge recursively, every other
+// value replaces what the payload already holds.
+func mergeExtra(dst map[string]any, extra map[string]any) {
+	for k, v := range extra {
+		src, ok := v.(map[string]any)
+		if !ok {
+			dst[k] = v
+			continue
+		}
+		cur, ok := dst[k].(map[string]any)
+		if !ok {
+			cur = map[string]any{}
+		}
+		merged := make(map[string]any, len(cur)+len(src))
+		for ck, cv := range cur {
+			merged[ck] = cv
+		}
+		mergeExtra(merged, src)
+		dst[k] = merged
+	}
+}
